# ─── Server ───────────────────────────────────────────
PORT=5000

# ─── MongoDB ──────────────────────────────────────────
# Local:
MONGO_URI=mongodb://localhost:27017/ayusutra
# Atlas (production):
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ayusutra

# ─── JWT Auth ─────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string_here
JWT_EXPIRES_IN=7d

# ─── Google Maps API ──────────────────────────────────
# Enable in Google Cloud Console:
#   - Maps JavaScript API
#   - Places API (New)
#   - Geocoding API
GOOGLE_MAPS_API_KEY=AIzaSy_your_key_here

# ─── Anthropic API (Chatbot + Report Summarizer) ──────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ─── File Uploads ─────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
